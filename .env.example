# ============================================================================
# Leyla — environment configuration
# Copy this file to .env and fill in the values. NEVER commit .env.
# KataBump: upload .env to the root of your server (next to requirements.txt).
# ============================================================================

# ---------------------------------------------------------------- Discord ---
# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# Your own Discord user ID (right-click your name → Copy User ID; enable
# Developer Mode in Discord settings first). Leyla ignores everyone else.
OWNER_DISCORD_ID=

# Optional: additional owner IDs, comma separated.
OWNER_DISCORD_IDS=

# Optional alias: some hosting dashboards expose the same person's ID as
# GUILD_OWNER_ID. Either name works; OWNER_DISCORD_ID wins if both are set.
GUILD_OWNER_ID=

# Optional but recommended: your private server ID. Commands sync instantly to
# this guild instead of taking up to an hour globally.
DISCORD_GUILD_ID=

# Optional: restrict Leyla to specific guild channels (comma separated IDs).
# Leave empty to answer DMs + mentions only; /setup channel can override this
# at runtime without editing the file.
ALLOWED_CHANNEL_IDS=

# Display name used in prompts/logs.
BOT_NAME=Leyla

# ----------------------------------------------------------------- Storage ---
# SQLite lives on the server disk. The free KataBump plan has 716 MB total.
DATA_DIR=data
DB_PATH=data/leyla.sqlite3

# -------------------------------------------------------------- AI brain -----
# gemini (free tier), groq (free tier), openai (paid), openrouter, custom, echo
AI_PROVIDER=gemini

# Model IDs change over time. Free Gemini models in late 2026 include
# gemini-flash-latest (alias), gemini-3.8-flash, gemini-3.5-flash-lite.
# Groq free: openai/gpt-oss-120b. Set explicitly if an alias errors.
AI_MODEL=gemini-flash-latest

# Keys — only the one for your chosen provider is required.
# https://aistudio.google.com/apikey  (free tier, no card)
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted for Gemini.
GOOGLE_API_KEY=
# Generic key for AI_PROVIDER=custom (OpenAI-compatible endpoints).
AI_API_KEY=
# https://console.groq.com/keys  (free tier)
GROQ_API_KEY=
# https://platform.openai.com/api-keys  (paid)
OPENAI_API_KEY=
# https://openrouter.ai/keys  (free models available)
OPENROUTER_API_KEY=

# Optional: override the endpoint (required for AI_PROVIDER=custom).
AI_BASE_URL=

# Optional fallback providers tried if the primary fails, comma separated.
# Keys for each fallback must be present or the entry is skipped.
AI_FALLBACKS=

# When the primary model is overloaded (503) or retired (404), Leyla tries these
# IDs before giving up on the turn. Free Flash models hit "high demand" often.
AI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-flash-lite-latest

AI_TEMPERATURE=0.9
AI_MAX_OUTPUT_TOKENS=320
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
# Safety budget: hard stop on model calls per UTC day.
AI_DAILY_REQUEST_LIMIT=400
# How many past messages are replayed as context (bounded on purpose).
CHAT_HISTORY_TURNS=14
CHAT_MAX_MESSAGE_CHARS=1900
MEMORY_EXTRACTION_ENABLED=true
MEMORY_MAX_PER_SCOPE=400
# Owner messages per minute (anti-spam / runaway loops).
RATE_LIMIT_PER_MINUTE=12

# ------------------------------------------------------------------- Voice ---
# groq (Orpheus, expressive nonverbal tokens) | elevenlabs (audio tags) |
# openai | edge (free, needs extra package) | none
VOICE_PROVIDER=groq

# off | request | occasional | always
#   off        → never send voice notes
#   request    → only when you explicitly ask (/voice test, "send a voice note")
#   occasional → sometimes, weighted by mood and VOICE_FREQUENCY
#   always      → every suitable reply
VOICE_MODE=occasional
# 0.0 - 1.0 base chance for an occasional voice note (mood modifies it).
# Keep this low: she should speak now and then, not narrate the chat.
VOICE_FREQUENCY=0.15
# Orpheus only accepts 200 characters per request, tags included.
VOICE_MAX_CHARS=190
# Minutes between automatic voice notes.
VOICE_COOLDOWN_MINUTES=20
# Allow nonverbal cues (<laugh>, <chuckle>, <sigh>) when the provider supports them.
VOICE_NONVERBAL_ENABLED=true
# Character budgets (a hard stop before any API call).
TTS_DAILY_CHAR_LIMIT=2000
TTS_MONTHLY_CHAR_LIMIT=8000

# Groq Orpheus TTS (used when VOICE_PROVIDER=groq). Reuses GROQ_API_KEY above.
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# autumn | diana | hannah (female), austin | daniel | troy (male)
GROQ_TTS_VOICE=autumn
GROQ_TTS_URL=https://api.groq.com/openai/v1/audio/speech

# Optional alternative: set VOICE_PROVIDER=elevenlabs to use these.
# https://elevenlabs.io/app/settings/api-keys — free plan works, no card.
ELEVENLABS_API_KEY=
# Any premade voice from your library (this default is "Rachel", warm female).
# Do NOT clone a real person's voice.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_v4 / eleven_v3 support audio tags. Older models do not and are used
# only as fallbacks (tags are stripped automatically).
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_MODEL_FALLBACKS=eleven_v3,eleven_multilingual_v2
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEAKER_BOOST=true

# OpenAI TTS (only used when VOICE_PROVIDER=openai).
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=sage
OPENAI_TTS_INSTRUCTIONS=

# Optional free fallback provider: `pip install edge-tts` first.
EDGE_TTS_VOICE=en-US-AvaMultilingualNeural

# Path to ffmpeg. Leave empty to auto-detect (/usr/bin/ffmpeg, PATH, then
# imageio-ffmpeg if installed). Voice notes need ffmpeg for Ogg/Opus encoding.
FFMPEG_PATH=

# ------------------------------------------------------------------ Images ---
# none | pollinations (keyless) | openai (paid)
# Generation stays off unless IMAGE_GENERATION_ENABLED=true AND a provider is set.
IMAGE_PROVIDER=none
IMAGE_GENERATION_ENABLED=false
IMAGE_DAILY_LIMIT=4
IMAGE_SIZE=1024x1024
OPENAI_IMAGE_MODEL=gpt-image-1

# --------------------------------------------------------------------- Ops ---
LOG_LEVEL=INFO
# Optional rotating log file (1 MB × 2) — useful on KataBump where stdout is
# visible in the console but not persisted.
LOG_FILE=
ENVIRONMENT=production
